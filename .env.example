# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=production
PORT=3000

# REQUIRED in production: long random string, e.g. output of
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# SQLite database file (created automatically). Back this file up regularly.
DATABASE_PATH=data/app.db

# Private attachment storage (never served directly; access is checked per site).
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# Session lifetime in hours (sliding).
SESSION_HOURS=12

# Set true when served over HTTPS (default: true when NODE_ENV=production).
COOKIE_SECURE=true
# Set true when running behind a reverse proxy (nginx, IIS ARR, Caddy) that sets X-Forwarded-*.
TRUST_PROXY=false
