<%- include('../partials/top') %>
<div class="card" style="max-width:520px">
  <h1>Change password</h1>
  <% if (forced) { %><div class="alert alert-warn">You must set a new password before continuing.</div><% } %>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/account/password" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- ui.input({ name: 'current_password', type: 'password', label: forced ? 'Temporary / current password' : 'Current password', required: true, errors, autocomplete: 'current-password' }) %>
    <%- ui.input({ name: 'new_password', type: 'password', label: 'New password', required: true, errors, autocomplete: 'new-password', hint: 'At least 10 characters, including letters and numbers.' }) %>
    <%- ui.input({ name: 'confirm_password', type: 'password', label: 'Confirm new password', required: true, errors, autocomplete: 'new-password' }) %>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Change password</button></div>
  </form>
</div>
<%- include('../partials/bottom') %>
