<%- include('../partials/top') %>
<div class="page-head">
  <div><h1><%= rec.generator_name %> session <% if (!rec.stop_at) { %><%- ui.badge('Running') %><% } %> <% if (rec.is_demo) { %><span class="badge badge-demo">DEMO</span><% } %></h1><p><%= rec.site_name %> · started <%= time.formatDateTime(rec.start_at) %></p></div>
  <%- include('../partials/record-actions', { base: '/generator' }) %>
</div>
<% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<% if (!rec.stop_at && perms.canEdit) { %>
<section class="card" style="border-left:4px solid #16a34a;max-width:820px">
  <h2>Stop this session</h2>
  <form method="post" action="/generator/<%= rec.id %>/stop" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <%- ui.input({ name: 'stop_at', type: 'datetime-local', label: 'Stop date & time', required: true, value: (locals.values && values.stop_at) || nowLocal, errors }) %>
      <%- ui.input({ name: 'closing_hour_meter', type: 'number', label: 'Closing hour-meter', step: 'any', min: 0, inputmode: 'decimal', unit: 'h', errors, value: locals.values && values.closing_hour_meter }) %>
    </div>
    <button class="btn btn-primary" type="submit">Stop session</button>
  </form>
</section>
<% } %>
<div class="grid grid-2">
  <section class="card">
    <h2>Session</h2>
    <dl class="details">
      <dt>Project site</dt><dd><%= rec.site_name %></dd>
      <dt>Generator</dt><dd><%= rec.generator_name %></dd>
      <dt>Operating date</dt><dd><%= time.formatDate(rec.operating_date) %></dd>
      <dt>Start</dt><dd><%= time.formatDateTime(rec.start_at) %></dd>
      <dt>Stop</dt><dd><%- rec.stop_at ? ui.esc(time.formatDateTime(rec.stop_at)) : ui.badge('Running') %></dd>
      <dt>Runtime</dt><dd><strong style="font-size:1.2rem"><%= fmt.num(rec.runtime_hours) %> h</strong><%= rec.stop_at ? '' : ' so far' %></dd>
      <dt>Hour-meter</dt><dd><%= rec.opening_hour_meter ?? '—' %> → <%= rec.closing_hour_meter ?? '—' %><% if (rec.opening_hour_meter !== null && rec.closing_hour_meter !== null) { %> (<%= fmt.num(rec.closing_hour_meter - rec.opening_hour_meter) %> h)<% } %></dd>
      <dt>Reason</dt><dd><%= rec.reason %></dd>
      <dt>Operator</dt><dd><%= rec.operator_name %></dd>
      <dt>Remarks</dt><dd><%= rec.remarks || '—' %></dd>
    </dl>
  </section>
  <section class="card">
    <h2>Hours by date</h2>
    <p class="small muted">How this session's runtime is allocated in daily reports.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Date</th><th class="num">Hours</th></tr></thead>
      <tbody><% for (const a of rec.allocation) { %><tr><td><%= time.formatDate(a.date) %></td><td class="num"><%= fmt.num(a.hours) %></td></tr><% } %></tbody>
    </table></div>
    <dl class="details" style="margin-top:1rem">
      <dt>Created by</dt><dd><%= createdBy || '—' %> · <%= time.formatTimestamp(rec.created_at) %></dd>
      <dt>Last updated by</dt><dd><%= updatedBy || '—' %> · <%= time.formatTimestamp(rec.updated_at) %></dd>
    </dl>
  </section>
</div>
<%- include('../partials/history') %>
<%- include('../partials/bottom') %>
