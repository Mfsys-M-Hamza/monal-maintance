<%- include('../partials/top') %>
<div class="page-head">
  <div><h1>LPG consumption</h1><p>LPG consumed = Opening stock + Received − Closing stock. Kilograms by default; cylinder-based sites are shown separately.</p></div>
  <div class="actions"><a class="btn btn-primary" href="/lpg/new">+ New LPG record</a></div>
</div>
<%- include('../partials/list-filters', { action: '/lpg', extra: `<label class="check" style="flex:0 0 auto;margin-bottom:.6rem"><input type="checkbox" name="flagged" value="1" ${query.flagged === '1' ? 'checked' : ''}> <span>Flagged only</span></label>` }) %>
<div class="kpis">
  <div class="kpi"><div class="kpi-label">Consumed (kg-based sites)</div><div class="kpi-value"><%= fmt.num(totals.kg, 2) %><small>kg</small></div></div>
  <div class="kpi"><div class="kpi-label">Consumed (cylinder-based sites)</div><div class="kpi-value"><%= fmt.num(totals.cyl, 0) %><small>cylinders</small></div></div>
  <div class="kpi"><div class="kpi-label">Records</div><div class="kpi-value"><%= pg.total %></div></div>
</div>
<div class="table-wrap">
  <table class="responsive">
    <thead><tr><th>Date</th><th>Site</th><th>Unit</th><th class="num">Opening</th><th class="num">Received</th><th class="num">Closing</th><th class="num">Consumed</th><th>Recorded by</th><th></th></tr></thead>
    <tbody>
    <% if (!rows.length) { %><tr><td colspan="9" class="empty">No LPG records for these filters. <a href="/lpg/new">Add one</a>.</td></tr><% } %>
    <% for (const r of rows) { const u = r.unit === 'kg' ? 'kg' : 'cyl'; %>
      <tr>
        <td data-label="Date" class="nowrap"><%= time.formatDate(r.record_date) %> <% if (r.is_demo) { %><span class="badge badge-demo">DEMO</span><% } %></td>
        <td data-label="Site"><%= r.site_name %></td>
        <td data-label="Unit"><%= r.unit === 'kg' ? 'kg' : `cylinders (${r.cylinder_kg} kg)` %></td>
        <td data-label="Opening" class="num"><%= fmt.num(r.opening_stock) %></td>
        <td data-label="Received" class="num"><%= fmt.num(r.received_stock) %></td>
        <td data-label="Closing" class="num"><%= fmt.num(r.closing_stock) %></td>
        <td data-label="Consumed" class="num"><strong><%= fmt.num(r.consumed) %> <%= u %></strong><% if (r.opening_mismatch) { %> <span class="badge badge-warn" title="Opening differs from previous closing (<%= r.expected_opening %>)">opening ≠ prev. closing</span><% } %></td>
        <td data-label="Recorded by"><%= r.recorded_by %></td>
        <td class="actions-cell"><a class="btn btn-outline btn-sm" href="/lpg/<%= r.id %>">View</a></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<%- ui.pagination('/lpg', Object.fromEntries(Object.entries(query).filter(([k]) => k !== 'page')), pg.page, pg.pages) %>
<%- include('../partials/bottom') %>
