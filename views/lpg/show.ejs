<%- include('../partials/top') %>
<div class="page-head">
  <div><h1>LPG record <% if (rec.is_demo) { %><span class="badge badge-demo">DEMO</span><% } %></h1><p><%= rec.site_name %> · <%= time.formatDate(rec.record_date) %></p></div>
  <%- include('../partials/record-actions', { base: '/lpg' }) %>
</div>
<div class="grid grid-2">
  <section class="card">
    <h2>Stock balance (<%= rec.unit_label %>)</h2>
    <dl class="details">
      <dt>Project site</dt><dd><%= rec.site_name %></dd>
      <dt>Date</dt><dd><%= time.formatDate(rec.record_date) %></dd>
      <dt>Unit</dt><dd><%= rec.unit === 'kg' ? 'Kilograms (kg)' : `Cylinders (net ${rec.cylinder_kg} kg each)` %></dd>
      <dt>Opening stock</dt><dd><%= fmt.num(rec.opening_stock) %> <%= rec.unit_label %>
        <% if (rec.opening_mismatch) { %><br><span class="badge badge-warn">Differs from previous closing stock (<%= fmt.num(rec.expected_opening) %>)</span><% } %></dd>
      <dt>Received</dt><dd><%= fmt.num(rec.received_stock) %> <%= rec.unit_label %></dd>
      <dt>Closing stock</dt><dd><%= fmt.num(rec.closing_stock) %> <%= rec.unit_label %></dd>
      <dt>Consumed</dt><dd><strong style="font-size:1.2rem"><%= fmt.num(rec.consumed) %> <%= rec.unit_label %></strong>
        <% if (rec.unit === 'cylinder') { %><br><span class="muted small">≈ <%= fmt.num(rec.consumed * rec.cylinder_kg) %> kg (converted at <%= rec.cylinder_kg %> kg/cylinder)</span><% } %></dd>
      <dt>Recorded by</dt><dd><%= rec.recorded_by %></dd>
      <dt>Remarks</dt><dd><%= rec.remarks || '—' %></dd>
    </dl>
  </section>
  <section class="card">
    <h2>Record information</h2>
    <dl class="details">
      <dt>Created by</dt><dd><%= createdBy || '—' %> · <%= time.formatTimestamp(rec.created_at) %></dd>
      <dt>Last updated by</dt><dd><%= updatedBy || '—' %> · <%= time.formatTimestamp(rec.updated_at) %></dd>
    </dl>
  </section>
</div>
<%- include('../partials/history') %>
<%- include('../partials/bottom') %>
