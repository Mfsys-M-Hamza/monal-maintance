<%- include('../partials/top') %>
<div class="page-head"><div><h1><%= entity ? `Edit generator: ${entity.name}` : 'New generator' %></h1></div><div class="actions"><a class="btn btn-outline" href="/admin/equipment">Back</a></div></div>
<div class="card" style="max-width:820px">
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="<%= entity ? `/admin/generators/${entity.id}` : '/admin/generators' %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <% if (entity) { %>
        <div class="field"><label>Site</label><input type="text" readonly value="<%= (sites.find((s) => s.id === entity.site_id) || {}).name %>"></div>
        <input type="hidden" name="site_id" value="<%= entity.site_id %>">
      <% } else { %>
        <%- ui.select({ name: 'site_id', label: 'Site', required: true, options: ui.siteOptions(sites), value: values.site_id, placeholder: 'Select site…', errors, dataset: { 'site-source': '1' } }) %>
      <% } %>
      <%- ui.input({ name: 'name', label: 'Generator name', required: true, value: values.name, errors, placeholder: 'e.g. Generator 1 (500 kVA)' }) %>
      <%- ui.input({ name: 'capacity_kva', type: 'number', label: 'Capacity', value: values.capacity_kva, step: 'any', min: 0, unit: 'kVA', errors }) %>
      <div class="field<%= errors.tank_id ? ' has-error' : '' %>">
        <label for="f-tank_id">Diesel tank</label>
        <select id="f-tank_id" name="tank_id" data-site-filtered="site_id">
          <option value="">No tank linked</option>
          <% for (const t of tanks) { if (entity && t.site_id !== entity.site_id) continue; %><option value="<%= t.id %>" data-site="<%= t.site_id %>" <%= String(values.tank_id) === String(t.id) ? 'selected' : '' %>><%= t.name %> (<%= t.tank_type %>)</option><% } %>
        </select>
        <small class="hint">Diesel runtime comparisons need a linked tank.</small>
        <% if (errors.tank_id) { %><small class="error-text"><%= errors.tank_id %></small><% } %>
      </div>
    </div>
    <% if (entity) { %><%- ui.checkbox({ name: 'is_active', label: 'Generator active', checked: !!Number(values.is_active) }) %><% } %>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Save generator</button></div>
  </form>
</div>
<%- include('../partials/bottom') %>
