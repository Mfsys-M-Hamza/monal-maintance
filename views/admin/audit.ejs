<%- include('../partials/top') %>
<div class="page-head"><div><h1>Audit trail</h1><p>Every create, update, delete, lock, sign-in and export, with previous and updated values. <%= pg.total %> entries.</p></div></div>
<form class="filters" method="get" action="/admin/audit">
  <div class="field"><label for="a-entity">Record type</label><select id="a-entity" name="entity"><option value="">All</option>
    <% for (const e of entities) { %><option value="<%= e %>" <%= f.entity === e ? 'selected' : '' %>><%= e.replace(/_/g, ' ') %></option><% } %></select></div>
  <div class="field"><label for="a-site">Site</label><select id="a-site" name="site"><option value="">All</option>
    <% for (const s of sites) { %><option value="<%= s.id %>" <%= String(f.site) === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% } %></select></div>
  <div class="field"><label for="a-user">User</label><input id="a-user" type="search" name="user" value="<%= f.user || '' %>"></div>
  <div class="field"><label for="a-id">Record ID</label><input id="a-id" type="number" name="entity_id" value="<%= f.entity_id || '' %>"></div>
  <div class="field"><label for="a-from">From</label><input id="a-from" type="date" name="from" value="<%= f.from || '' %>"></div>
  <div class="field"><label for="a-to">To</label><input id="a-to" type="date" name="to" value="<%= f.to || '' %>"></div>
  <button class="btn btn-navy" type="submit">Filter</button>
</form>
<div class="table-wrap">
  <table class="responsive">
    <thead><tr><th>When (PKT)</th><th>User</th><th>Action</th><th>Record</th><th>Site</th><th>Changes</th></tr></thead>
    <tbody>
    <% if (!rows.length) { %><tr><td colspan="6" class="empty">No audit entries match.</td></tr><% } %>
    <% for (const a of rows) { %>
      <tr>
        <td data-label="When" class="nowrap small"><%= time.formatTimestamp(a.created_at) %></td>
        <td data-label="User"><%= a.username || '—' %><div class="muted small"><%= a.ip || '' %></div></td>
        <td data-label="Action"><%- ui.badge(a.action.replace(/_/g, ' '), a.action === 'delete' ? 'danger' : a.action === 'create' ? 'ok' : a.action.includes('fail') ? 'warn' : 'info') %></td>
        <td data-label="Record"><%= a.entity_type.replace(/_/g, ' ') %><%= a.entity_id ? ' #' + a.entity_id : '' %></td>
        <td data-label="Site"><%= a.site_name || '—' %></td>
        <td data-label="Changes" style="max-width:520px">
          <% if (a.reason) { %><div class="small"><strong>Note:</strong> <%= a.reason %></div><% } %>
          <% if (a.action === 'update' || a.action === 'complete' || a.action === 'reschedule') { %>
            <% for (const c of a.changes.slice(0, 12)) { %><div class="small"><strong><%= c.field %></strong>: <%- ui.auditValue(c.before) %> → <%- ui.auditValue(c.after) %></div><% } %>
          <% } else if (a.after_json || a.before_json) { %>
            <details class="small"><summary><%= a.after_json ? 'Values' : 'Previous values' %></summary><code style="word-break:break-all"><%= a.after_json || a.before_json %></code></details>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<%- ui.pagination('/admin/audit', Object.fromEntries(Object.entries(query).filter(([k]) => k !== 'page')), pg.page, pg.pages) %>
<%- include('../partials/bottom') %>
